# ---------------------------------------------------------------------------
# Core (existing donation platform + ecommerce automation platform)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Set on the Convex dashboard as well (used by convex/auth.config.ts)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ---------------------------------------------------------------------------
# Ecommerce automation – set these as Convex environment variables
# (Convex dashboard → Settings → Environment variables). Everything is
# optional: without them the platform runs in demo mode with templates and
# simulated channels.
# ---------------------------------------------------------------------------
# Claude API – powers research, copy, creatives, targeting, outreach
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Product image generation (pick one). Without it, branded SVG mockups are used.
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# IMAGE_PROVIDER=stability
# STABILITY_API_KEY=sk-...

# Storefront payments (Stripe Checkout) + refunds on cancellation
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shopify, Meta, TikTok, Google Ads, Resend/SMTP, Twilio, fulfilment (3PL webhook /
# Printful) and AfterShip credentials are entered per store in the dashboard:
# /ecommerce/dashboard/settings?tab=integrations
